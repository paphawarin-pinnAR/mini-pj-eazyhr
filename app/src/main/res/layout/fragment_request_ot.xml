<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_sub"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.view.fragment.RequestCheckOutFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
       >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Request OT"
            android:paddingLeft="5dp"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Date: " />

        <EditText
            android:id="@+id/editTextOTDate"
            android:layout_width="250dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:ems="10"
            android:inputType="date"

            />

        <ImageView
            android:id="@+id/imageOTDate"
            android:layout_width="30dp"
            android:layout_height="29dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_calendar_month" />


    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        >

        <CheckBox
            android:id="@+id/checkboxBreakTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Break 20 mins" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/title_from_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="From time:" />

        <EditText
            android:id="@+id/edit_from_time"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:ems="10"
            android:hint="hh:mm"
            android:inputType="time" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/title_to_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="To time:" />

        <EditText
            android:id="@+id/edit_to_time"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginStart="25dp"
            android:ems="10"
            android:hint="hh:mm"
            android:inputType="time" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reason:"
            android:layout_marginStart="18dp"


           />

        <EditText
            android:id="@+id/editTextReason"
            android:layout_width="320dp"
            android:layout_height="60dp"
            android:layout_margin="20dp"
            android:ems="100"
            android:inputType="textMultiLine"
            android:background="@drawable/border_reason"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/btn_save_background"
            android:text="SAVE"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:backgroundTint="#b90203"
            android:text="CANCEL" />
    </LinearLayout>



</LinearLayout>