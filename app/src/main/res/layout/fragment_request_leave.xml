<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_sub"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".RequestLeaveFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Request Leave"
            android:paddingLeft="12dp"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title_from_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Leave type:" />

        <Spinner
            android:id="@+id/spinner_leave_type"
            android:layout_width="238dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/spinner_underline"

            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title_from_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="From date: " />

        <EditText
            android:id="@+id/editTextFromDate"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:ems="10"
            android:hint="MMM dd, YYYY"
            android:inputType="date"

            />

        <ImageView
            android:id="@+id/imageLeaveFromDate"
            android:layout_width="33dp"
            android:layout_height="29dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_calendar" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title_to_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="To date: " />

        <EditText
            android:id="@+id/editTextToDate"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginStart="26dp"
            android:ems="10"
            android:hint="MMM dd, YYYY"
            android:inputType="date"
            />

        <ImageView
            android:id="@+id/imageLeaveToDate"
            android:layout_width="33dp"
            android:layout_height="29dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_calendar" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Period:" />

        <Spinner
            android:id="@+id/spinner_leave_period"
            android:layout_width="238dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_weight="1"
            android:background="@drawable/spinner_underline"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Reason:"
            />

        <EditText
            android:id="@+id/editTextReason"
            android:layout_width="320dp"
            android:layout_height="60dp"
            android:layout_margin="20dp"
            android:ems="100"
            android:inputType="textMultiLine"
            android:background="@drawable/border_reason"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/btn_save_background"
            android:text="SAVE"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:backgroundTint="#b90203"
            android:text="CANCEL" />
    </LinearLayout>



</LinearLayout>