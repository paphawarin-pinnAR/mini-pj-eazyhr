<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_default_color_surface"
    android:orientation="vertical"
    android:paddingTop="50dp"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/btnCheckInOut"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_button_check_in"
            android:text="Check In"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textAllCaps="false"/>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        >

        <TextView
            android:id="@+id/txt_checkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="50dp"
            android:hapticFeedbackEnabled="false"
            android:text="Check in at "
            android:textSize="16sp" />

        <TextView
            android:id="@+id/time_checkin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@null"
            android:ems="5"
            android:gravity="center_vertical"
            android:hint="xx:xx"
            android:inputType="time"
            android:textSize="16sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_checkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:text="Check out at "
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/time_checkout"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:ems="5"
            android:gravity="center_vertical"
            android:hint="xx:xx"
            android:inputType="time"
            android:textSize="16sp"/>

    </LinearLayout>





</LinearLayout>